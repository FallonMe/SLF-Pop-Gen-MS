Will use part of GATK pipeline that created by NYU Genecore 
https://gencore.bio.nyu.edu/variant-calling-pipeline-gatk4/

“We removed sequencing and sample barcode adapters as well as trimmed and filtered reads based on quality scores using Illumiprocessor (84) (v2.09),
a wrapper for the read filtering program Trimmomatic (85) (v0.32). 
We  aligned  our  quality  filtered  reads  to reference genome  using  BWA  (87)  (v0.7.17-r1188).  
We  called and  filtered   variants using GATK (88) following the GATK best practices (89, 90) with the  exception of Base Quality Score Recalibration, 
which was not possible as there does not exist a reference variant set for Anolis cristatellus. We first marked  duplicates and called haplotypes for each sample individually, 
and  jointly called genotypes using all individuals.  

# 1. Divide 99 samples into 10 groups as Nextflow produces too many large intermediate files, has to delete all and rerun another 10, run 10 each time

folder_path="/scratch/fm2371/Winchell/SLF_spring23/SLF_spring23"
cd "$folder_path"

# Variables
src_dir="/scratch/fm2371/Winchell/SLF_spring23/SLF_spring23"
dest_dir="/scratch/fm2371/Winchell/SLF_spring23/SLF_spring23"
count=1
group=1

# Create destination directories
mkdir -p "${dest_dir}/Group_{1..10}"

# Loop through the NYU* folders and move them to the destination directories
for folder in "${src_dir}/NYU"*; do
    mv "$folder" "${dest_dir}/Group_${group}/"
    if [ $count -eq 10 ]; then
        count=1
        group=$((group+1))
    else
        count=$((count+1))
    fi
done

# 2. Manipulate the files at a time

for d in NYU*/; do cd $d; cp -r ../vcf_scripts .; folder_path=$(pwd); echo $folder_path; sed -i "s|/scratch/cgsb/rockman/AB1/|$folder_path/|g" vcf_scripts/nextflow.config; cd .. ; done

find . -type f -path "*/NYU*/vcf_scripts/nextflow.sh" -exec sed -i 's/mem=60GB/mem=4GB/g' {} \;
find . -type f -path "*/NYU*/vcf_scripts/nextflow.sh" -exec sed -i 's/mem=32GB/mem=4GB/g' {} \;

find . -type f -path "*/NYU*/vcf_scripts/nextflow.sh" -exec sed -i 's/#SBATCH --cpus-per-task=32/#SBATCH --cpus-per-task=4/g’ {} \;

find ./ -type f -path "*/NYU*/vcf_scripts/nextflow.sh" -exec sed -i 's/#SBATCH --cpus-per-task=32/#SBATCH --cpus-per-task=4/g’ {} \;

find . -type d -name "NYU*" -exec sh -c 'sed -i "s/time=96:00:00/time=10:00:00/g" "{}/vcf_scripts/nextflow.sh"' \;

find /scratch/fm2371/Winchell/SLF_spring23/SLF_spring23/Group_10 -type f -path "*/vcf_scripts/nextflow.sh" -exec sed -i 's/nextflow run main.nf -resume/nextflow run main.nf/g' {} \;

find /scratch/fm2371/Winchell/SLF_spring23/SLF_spring23/Group_10 -type f -path "*/vcf_scripts/nextflow.config" -exec sed -i 's/params.fcid = "HK5NHBGXX"/params.fcid = "HK77KDMXY"/g' {} \;

find /scratch/fm2371/Winchell/SLF_spring23/SLF_spring23/Group_10 -type f -path "*/vcf_scripts/slurm*" -exec rm {} \;

find /scratch/fm2371/Winchell/SLF_spring23/SLF_spring23/Group_9 -type f -name "nextflow.config" -exec grep "params.reads" {} +

find . -type d -name "NYU*" -exec sh -c 'cd "{}" && cd vcf_scripts && sbatch nextflow.sh && cd ../../' \;

# 3. Index all bam files

module load samtools/intel/1.14

directory="/scratch/fm2371/Winchell/SLF_spring23/SLF_spring23/BAMFILES/BAMFILES/"

for file in "${directory}"*.bam
do
    echo "Indexing ${file} ..."
    samtools index "${file}"
    echo "${file} indexed."
