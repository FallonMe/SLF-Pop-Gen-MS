/share/apps/gatk/4.1.9.0/gatk IndexFeatureFile -I SLF.combined.vcf.gz

# 9. Extract the SNPs and Indels from this combined vcf, respectively

/share/apps/gatk/4.1.9.0/gatk SelectVariants \
-R /scratch/fm2371/Winchell/SLF_spring23/SLF_spring23/FinalAssembly/REF.fasta \
    -V SLF.combined.vcf.gz \
    --select-type-to-include SNP \
