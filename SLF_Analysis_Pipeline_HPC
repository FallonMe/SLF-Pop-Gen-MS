# Loop over K values from 1 to 40
for K in {1..40}; do
    echo "Running fastStructure for K=$K..."
    $SINGULARITY_CMD structure.py --input=$DATA_PATH --output=${OUTPUT_PATH}_K${K} -K $K
done

# Determine the best K using chooseK.py
# Note: If the chooseK.py utility is also in the Singularity container, you'll need to run it similarly.
echo "Determining the best K..."
$SINGULARITY_CMD chooseK.py --input=$OUTPUT_PATH

# Display the results
cat ${OUTPUT_PATH}_chosenK

# 17. Use Picard to get the aligment and coverage info.
module purge
module load picard/2.17.11

# Path to reference genome fasta file
REFERENCE=/scratch/fm2371/Winchell/SLF_spring23/SLF_spring23/FinalAssembly/REF.fasta

# Path to Picard jar file
PICARD_JAR=/share/apps/picard/2.17.11/picard.jar

# Loop through each BAM file listed in modified_bamfiles.txt
while read -r BAMFILE; do
    # Extract the sample name from the BAM file name
    SAMPLE_NAME=$(basename "$BAMFILE" .bam)
    
    # Run CollectWgsMetrics
    java -jar $PICARD_JAR CollectWgsMetrics \
        I=$BAMFILE \
        O="${SAMPLE_NAME}_wgs_metrics.txt" \
        R=$REFERENCE
    
    # Run CollectAlignmentSummaryMetrics
    java -jar $PICARD_JAR CollectAlignmentSummaryMetrics \
        R=$REFERENCE \
        I=$BAMFILE \
        O="${SAMPLE_NAME}_alignment_summary_metrics.txt"
        
done < bam_list.txt

### Then combine all txt files
# Initialize the combined file with headers
echo -e "SampleID\tGENOME_TERRITORY\tMEAN_COVERAGE\tSD_COVERAGE\tMEDIAN_COVERAGE\tMAD_COVERAGE\tPCT_EXC_MAPQ\tPCT_EXC_DUPE\tPCT_EXC_UNPAIRED\tPCT_EXC_BASEQ\tPCT_EXC_OVERLAP\tPCT_EXC_CAPPED\tPCT_EXC_TOTAL\tPCT_1X\tPCT_5X\tPCT_10X\tPCT_15X\tPCT_20X\tPCT_25X\tPCT_30X\tPCT_40X\tPCT_50X\tPCT_60X\tPCT_70X\tPCT_80X\tPCT_90X\tPCT_100X\tHET_SNP_SENSITIVITY\tHET_SNP_Q" > combined_wgs_metrics.txt

# Loop through each file and append the relevant lines to the combined file
for file in *_wgs_metrics.txt; do
  # Extract the sample name from the filename
  sample_name=$(basename "$file" "_wgs_metrics.txt")
  
  # Extract the 8th line and append it to the combined file
  awk -v sample="$sample_name" 'NR==8 {print sample "\t" $0}' "$file" >> combined_wgs_metrics.txt
done

### Combine alignment files
for file in *_alignment_summary_metrics.txt; do
    sample_name=$(basename "$file" "_alignment_summary_metrics.txt")
    
    # Assuming the PAIR metrics line can be identified by having "PAIR" as the first word
    awk -v sample="$sample_name" '$1=="PAIR" {print sample "\t" $0}' "$file" >> combined_alignment_summary_metrics.txt
done


