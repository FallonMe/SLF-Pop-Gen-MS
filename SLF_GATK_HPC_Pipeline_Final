#!/bin/bash

#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --time=12:00:00
#SBATCH --mem=32GB
#SBATCH --job-name=plink_pipeline
#SBATCH --mail-type=BEGIN,END
#SBATCH --mail-user=fm2371@nyu.edu
#SBATCH --output=plink_pipeline.out

# Load necessary modules
module purge
module load bcftools/1.19
module load plink/1.9

# Define working directories
WORK_DIR="/scratch/work/winchell/Lanternfly/WGS/16_NoDownsample_VCF_Analysis/Final_annotated_VCF"
OUT_DIR="${WORK_DIR}/Separated"

# Define input files
FULL_VCF="${WORK_DIR}/Final.SLF_annotated_with_ID.vcf.gz"
SH_VCF="${OUT_DIR}/SH_final_annotated.vcf.gz"
USA_VCF="${OUT_DIR}/USA_final_annotated.vcf.gz"

# Define PLINK output files
SH_PLINK_PREFIX="${OUT_DIR}/SH_final_annotated"
USA_PLINK_PREFIX="${OUT_DIR}/USA_final_annotated"
MERGED_PLINK_PREFIX="${OUT_DIR}/Merged_final_annotated"

# Define sample lists
SH_SAMPLE_LIST="${OUT_DIR}/SH_population.txt"
USA_SAMPLE_LIST="${OUT_DIR}/US_population.txt"

# Create output directory if not exists
mkdir -p $OUT_DIR

echo "===== STEP 1: Extracting Shanghai & USA samples from Full VCF ====="
bcftools view -S $SH_SAMPLE_LIST -Oz -o $SH_VCF $FULL_VCF
bcftools view -S $USA_SAMPLE_LIST -Oz -o $USA_VCF $FULL_VCF

# Index the VCF files
echo "===== STEP 2: Indexing VCF files ====="
bcftools index $SH_VCF
bcftools index $USA_VCF

# Convert to PLINK binary format
echo "===== STEP 3: Converting VCF to PLINK format ====="
plink --vcf $SH_VCF --make-bed --out $SH_PLINK_PREFIX --allow-extra-chr --double-id
plink --vcf $USA_VCF --make-bed --out $USA_PLINK_PREFIX --allow-extra-chr --double-id

# Convert PLINK binary to raw format
echo "===== STEP 4: Converting PLINK binary to RAW format ====="
plink --bfile $SH_PLINK_PREFIX --recode A --out "${SH_PLINK_PREFIX}_raw" --allow-extra-chr
plink --bfile $USA_PLINK_PREFIX --recode A --out "${USA_PLINK_PREFIX}_raw" --allow-extra-chr

# Merge SH and USA PLINK datasets
echo "===== STEP 5: Merging Shanghai & USA PLINK datasets ====="
plink --bfile $SH_PLINK_PREFIX --bmerge ${USA_PLINK_PREFIX}.bed ${USA_PLINK_PREFIX}.bim ${USA_PLINK_PREFIX}.fam --make-bed --out $MERGED_PLINK_PREFIX --allow-extra-chr

# Convert merged dataset to raw format
echo "===== STEP 6: Converting Merged dataset to RAW format ====="
plink --bfile $MERGED_PLINK_PREFIX --recode A --out "${MERGED_PLINK_PREFIX}_raw" --allow-extra-chr
