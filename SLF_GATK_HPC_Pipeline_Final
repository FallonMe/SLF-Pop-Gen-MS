import pandas as pd
import re

# Function to process the VCF file and remove 'chr_' prefix
def modify_vcf(input_vcf, output_vcf):
    with open(input_vcf, 'r') as infile, open(output_vcf, 'w') as outfile:
        for line in infile:
            # Write header lines as-is
            if line.startswith("#"):
                outfile.write(line)
            else:
                # Split the line into columns and modify the CHROM column
                columns = line.strip().split('\t')
                columns[0] = re.sub(r'^chr_', '', columns[0])  # Remove 'chr_' prefix
                outfile.write('\t'.join(columns) + '\n')

# Input and output file paths
