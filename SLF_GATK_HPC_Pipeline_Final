    plink --file ${GENETIC_DISTANCE_DIR}/${prefix} --distance 'ibs' square --allow-extra-chr --out ${GENETIC_DISTANCE_DIR}/${prefix}_ibs
    echo "Finished processing genetic distance for $prefix."
