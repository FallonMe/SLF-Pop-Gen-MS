# Pipeline for Spotted Lanternfly (SLF) Data Analysis
# Organized into major numbered steps, with sub-steps for detailed processing

# ===========================================
# Step 1: Quality Trimming of Raw Reads
# ===========================================
# This step removes adapter sequences, low-quality bases, and short reads.
echo "Step 1: Trimming raw reads"

# Load the necessary module for trimming
module purge
module load trimgalore/0.6.6

# Directory setup
raw_data_dir="/scratch/work/winchell/Lanternfly/Aria/01_combined_raw_data"
trimmed_dir="/scratch/work/winchell/Lanternfly/Aria/02_trimmed"
mkdir -p $trimmed_dir

# Loop through all raw R1 files for trimming
cd $raw_data_dir
for R1 in *_combined_R1.fastq.gz; do
    PREFIX=$(basename "$R1" "_combined_R1.fastq.gz")
    trim_galore --paired --fastqc -j 4 --stringency 3 --length 50 \
        --output_dir $trimmed_dir "${PREFIX}_combined_R1.fastq.gz" "${PREFIX}_combined_R2.fastq.gz"
done

echo "Step 1 completed: Trimmed reads are in $trimmed_dir"

# ===========================================
# Step 2: Alignment to Reference Genome
# ===========================================
# Align reads to the SLF reference genome using BWA and generate sorted BAM files.
echo "Step 2: Alignment"

# Load modules
module purge
module load bwa/intel/0.7.17
module load samtools/intel/1.14

# Directory setup
reference="/scratch/fm2371/Winchell/sex/genome/SLF_Hap1.fasta"
alignment_dir="/scratch/work/winchell/Lanternfly/Aria/03_align_bam"
mkdir -p $alignment_dir

# Align paired-end reads
cd $trimmed_dir
for R1 in *_val_1.fq.gz; do
    PREFIX=$(basename "$R1" "_val_1.fq.gz")
    bwa mem -t 8 $reference "${PREFIX}_val_1.fq.gz" "${PREFIX}_val_2.fq.gz" | \
        samtools view -Sb - > "${alignment_dir}/${PREFIX}.bam"
    samtools sort -@ 8 "${alignment_dir}/${PREFIX}.bam" -o "${alignment_dir}/${PREFIX}_sorted.bam"
    samtools index "${alignment_dir}/${PREFIX}_sorted.bam"
    rm "${alignment_dir}/${PREFIX}.bam"  # Cleanup intermediate files
done

echo "Step 2 completed: Aligned reads are in $alignment_dir"

# ===========================================
# Step 3: Add Read Groups to BAM Files
# ===========================================
# Add metadata to BAM files for downstream analysis.
echo "Step 3: Adding Read Groups"

module purge
module load picard/2.17.11

rg_dir="/scratch/work/winchell/Lanternfly/Aria/05_RG_bam"
mkdir -p $rg_dir

for bam in $alignment_dir/*_sorted.bam; do
    PREFIX=$(basename "$bam" "_sorted.bam")
    java -jar /share/apps/picard/2.17.11/picard.jar AddOrReplaceReadGroups \
        I=$bam O="${rg_dir}/${PREFIX}_RG.bam" \
        RGID=$PREFIX RGLB=lib1 RGPL=illumina RGPU=unit1 RGSM=$PREFIX CREATE_INDEX=true
done

echo "Step 3 completed: Read groups added to BAM files in $rg_dir"

# ===========================================
# Step 4: Mark Duplicates
# ===========================================
# Identify and mark duplicate reads to avoid biases in variant calling.
echo "Step 4: Marking Duplicates"

module purge
module load gatk/4.3.0.0

dedup_dir="/scratch/work/winchell/Lanternfly/Aria/06_dedup"
mkdir -p $dedup_dir

for bam in $rg_dir/*.bam; do
    PREFIX=$(basename "$bam" "_RG.bam")
    /share/apps/gatk/4.3.0.0/gatk --java-options "-Xmx28g" MarkDuplicatesSpark \
        -I $bam -O "${dedup_dir}/${PREFIX}_dedup.bam"
    samtools index "${dedup_dir}/${PREFIX}_dedup.bam"
done

echo "Step 4 completed: Deduplicated BAM files are in $dedup_dir"

# ===========================================
# Step 5: Coverage Calculation
# ===========================================
# Calculate genome-wide coverage using Mosdepth.
echo "Step 5: Calculating Coverage"

module purge
module load mosdepth/0.3.1

coverage_dir="/scratch/work/winchell/Lanternfly/Aria/07_coverage"
mkdir -p $coverage_dir

for bam in $dedup_dir/*.bam; do
    PREFIX=$(basename "$bam" "_dedup.bam")
    mosdepth --threads 8 --fast-mode "${coverage_dir}/${PREFIX}" $bam
done

echo "Step 5 completed: Coverage results are in $coverage_dir"

# ===========================================
# Step 6: Variant Calling
# ===========================================
# Call variants using GATK HaplotypeCaller.
echo "Step 6: Variant Calling"

gvcf_dir="/scratch/work/winchell/Lanternfly/Aria/10_gvcfs"
mkdir -p $gvcf_dir

for bam in $dedup_dir/*.bam; do
    PREFIX=$(basename "$bam" "_dedup.bam")
    /share/apps/gatk/4.3.0.0/gatk --java-options "-Xmx24G" HaplotypeCaller \
        -R $reference -I $bam -O "${gvcf_dir}/${PREFIX}.g.vcf.gz" -ERC GVCF
done

echo "Step 6 completed: GVCFs are in $gvcf_dir"

# ===========================================
# Step 7: Joint Genotyping
# ===========================================
# Combine GVCFs and perform joint genotyping.
echo "Step 7: Joint Genotyping"

combined_gvcf="/scratch/work/winchell/Lanternfly/Aria/11_joint_genotyping/combined.g.vcf.gz"
final_vcf="/scratch/work/winchell/Lanternfly/Aria/11_joint_genotyping/joint_genotyped.vcf.gz"
mkdir -p $(dirname $combined_gvcf)

/share/apps/gatk/4.3.0.0/gatk --java-options "-Xmx24G" CombineGVCFs \
    -R $reference -V $gvcf_dir/*.g.vcf.gz -O $combined_gvcf

/share/apps/gatk/4.3.0.0/gatk --java-options "-Xmx10G" GenotypeGVCFs \
    -R $reference -V $combined_gvcf -O $final_vcf

echo "Step 7 completed: Joint genotyping results are in $final_vcf"

# ===========================================
# Step 8: SNP and Indel Extraction
# ===========================================
# Extract SNPs and Indels from the final VCF.
echo "Step 8: Extracting SNPs and Indels"

snps_vcf="/scratch/work/winchell/Lanternfly/Aria/11_joint_genotyping/SLF.SNPs.vcf.gz"
indels_vcf="/scratch/work/winchell/Lanternfly/Aria/11_joint_genotyping/SLF.Indels.vcf.gz"

/share/apps/gatk/4.3.0.0/gatk SelectVariants \
    -R $reference -V $final_vcf --select-type-to-include SNP -O $snps_vcf

/share/apps/gatk/4.3.0.0/gatk SelectVariants \
    -R $reference -V $final_vcf --select-type-to-include INDEL -O $indels_vcf

echo "Step 8 completed: SNPs in $snps_vcf, Indels in $indels_vcf"

# ===========================================
# Step 9: Data Export for Analysis
# ===========================================
# Convert variants to tables for downstream analysis.
echo "Step 9: Converting VCFs to Tables"

snps_table="${snps_vcf%.vcf.gz}.table"
indels_table="${indels_vcf%.vcf.gz}.table"

/share/apps/gatk/4.3.0.0/gatk VariantsToTable \
    -V $snps_vcf -F CHROM -F POS -F DP -F QUAL -F MQ -F QD -F FS -F SOR -O $snps_table

/share/apps/gatk/4.3.0.0/gatk VariantsToTable \
    -V $indels_vcf -F CHROM -F POS -F DP -F QUAL -F MQ -F QD -F FS -F SOR -O $indels_table

echo "Step 9 completed: Tables exported for analysis"


# ===========================================
# Step 10: Check all stats distrubution in R, then do the hard filtering.
We have over 40 million SNPs, and we do very strigent filtering.
# ===========================================

# Define input and output files
INPUT_VCF="/scratch/work/winchell/Lanternfly/Aria/11_joint_genotyping/SLF.SNPs.vcf.gz"
REFERENCE="/scratch/fm2371/Winchell/sex/genome/SLF_Hap1.fasta"
HARD_FILTERED_VCF="final.SLF.SNPs.hardfiltered.vcf"
PASSED_VCF="final.SLF.SNPs.hardfiltered.passed.vcf"
BIALLELIC_VCF="final.SLF.SNPs.hardfiltered.passed.biallelic.vcf.gz"
STATS_BEFORE="stats_before_filtering.txt"
STATS_AFTER="stats_after_filtering.txt"

# Generate statistics before filtering
echo "Generating statistics for the unfiltered VCF..."
bcftools stats $INPUT_VCF > $STATS_BEFORE
echo "Statistics before filtering saved to $STATS_BEFORE."

# Apply hard filters to the SNPs
echo "Applying hard filters to SNPs..."
gatk VariantFiltration \
    -V $INPUT_VCF \
    -R $REFERENCE \
    -filter "QUAL < 30.0" --filter-name "QUAL30" \
    -filter "QD < 10.0" --filter-name "QD10" \
    -filter "FS > 10.0" --filter-name "FS10" \
    -filter "MQ < 50.0" --filter-name "MQ50" \
    -filter "MQRankSum < -1.0" --filter-name "MQRankSum-1" \
    -filter "MQRankSum > 1.0" --filter-name "MQRankSum1" \
    -filter "ReadPosRankSum < -1.0" --filter-name "ReadPosRankSum-1" \
    -filter "ReadPosRankSum > 1.0" --filter-name "ReadPosRankSum1" \
    -filter "SOR > 2.0" --filter-name "SOR2" \
    -O $HARD_FILTERED_VCF

echo "Hard filtering completed. Filtered VCF saved to $HARD_FILTERED_VCF."

# Extract PASS variants
echo "Extracting PASS variants..."
bcftools view -f PASS $HARD_FILTERED_VCF > $PASSED_VCF
echo "PASS variants extracted and saved to $PASSED_VCF."

# Retain only biallelic SNPs
echo "Filtering for biallelic SNPs..."
bcftools view -m2 -M2 -v snps $PASSED_VCF -o $BIALLELIC_VCF -Oz
bcftools index $BIALLELIC_VCF
echo "Biallelic SNPs retained and saved to $BIALLELIC_VCF."

# Generate statistics after filtering
echo "Generating statistics for the filtered VCF..."
bcftools stats $BIALLELIC_VCF > $STATS_AFTER
echo "Statistics after filtering saved to $STATS_AFTER."

# Summary of SNP counts before and after filtering
echo "Summary of SNP counts:"
grep "number of SNPs" $STATS_BEFORE
grep "number of SNPs" $STATS_AFTER

echo "Hard filtering, biallelic SNP filtering, and statistics generation completed successfully."

