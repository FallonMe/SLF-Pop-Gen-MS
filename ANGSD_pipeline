Step 4: Genome-wide Heterozygosity Estimation with ANGSD
# Paths
BAM_LIST="/scratch/work/winchell/Lanternfly/WGS/ANGSD/bam_list.txt"
REF="/scratch/work/winchell/Lanternfly/WGS/Ref_genome/SLF_Hap1.fasta"
OUTPUT_DIR="/scratch/work/winchell/Lanternfly/WGS/ANGSD/SFS"
#mkdir -p $OUTPUT_DIR

# Get the BAM file for the current array job
BAM=$(sed -n "${SLURM_ARRAY_TASK_ID}p" $BAM_LIST)

# Ensure the BAM file exists
if [[ ! -f "$BAM" ]]; then
    echo "Error: BAM file $BAM not found. Exiting."
    exit 1
fi

# Define output prefix
OUT_PREFIX=$(basename $BAM .bam)

# Step 1: Run ANGSD to calculate SAF
echo "Running ANGSD for sample ${OUT_PREFIX}..."
angsd -i $BAM \
 -C 50 \
 -ref $REF \
 -anc $REF \
 -dosaf 1 \
 -fold 1 \
 -GL 1 \
 -nThreads 24 \
 -minmapq 30 \
 -minQ 20 \
 -uniqueOnly 1 \
 -remove_bads 1 \
 -only_proper_pairs 1 \
 -out ${OUTPUT_DIR}/${OUT_PREFIX}

# Check if SAF file is generated
if [[ -f "${OUTPUT_DIR}/${OUT_PREFIX}.saf.idx" ]]; then
    echo "SAF file generated successfully for ${OUT_PREFIX}."
else
    echo "Error: SAF file not generated for ${OUT_PREFIX}. Exiting."
    exit 1
fi

