BAM_LIST="/scratch/work/winchell/Lanternfly/WGS/ANGSD/bam_list.txt"
OUTPUT="/scratch/work/winchell/Lanternfly/WGS/ANGSD"
REF="/scratch/work/winchell/Lanternfly/WGS/Ref_genome/SLF_Hap1.fasta"

# Generate bam_list.txt
ls $BAMS_DIR/*.bam | sort -V > $BAM_LIST

# Run ANGSD for SNP calling

# Paths
BAMS_DIR="/scratch/work/winchell/Lanternfly/WGS/06_dedup"
BAM_LIST="/scratch/work/winchell/Lanternfly/WGS/ANGSD/bam_list.txt"
OUTPUT="/scratch/work/winchell/Lanternfly/WGS/ANGSD/"
REF="/scratch/work/winchell/Lanternfly/WGS/Ref_genome/SLF_Hap1.fasta"

# Create bam_list.txt
#mkdir -p "$(dirname $BAM_LIST)"
#ls $BAMS_DIR/*.bam | sort -V > $BAM_LIST

# Run ANGSD
angsd -GL 2 \
      -doGlf 2 \
      -doDepth 1 \
      -doCounts 1 \
      -doMajorMinor 1 \
      -doMaf 2 \
      -minMaf 0.05 \
      -SNP_pval 1e-6 \
      -uniqueOnly 1 \
      -minMapQ 30 \
      -minQ 20 \
      -skipTriallelic 1 \
      -nThreads 16 \
      -minInd 112 \
      -bam $BAM_LIST \
      -remove_bads 1 \
      -trim 0 -C 50 -baq 1
      -only_proper_pairs 1 \
      -setMinDepth 5 -setMaxDepth 30 \
      -ref $REF  \
      -out NEW_minInd112

-GL 2: Use GATK genotype likelihood model.
-doGlf 2: Output genotype likelihoods in Beagle format (suitable for downstream tools like PCAngsd).
-doDepth 1: Calculate depth of coverage at each site.
-doCounts 1: Count the number of A, C, G, and T alleles.
-doMajorMinor 1: Infer the major and minor alleles based on genotype likelihoods.
-doMaf 2: Calculate minor allele frequency (MAF) using fixed major and inferred minor alleles.
-minMaf 0.05: Remove sites with MAF < 5%.
-SNP_pval 1e-6: Filter out SNPs with p-value > 1e-6.
-uniqueOnly 1: Use only uniquely mapped reads.
-minMapQ 30: Discard reads with mapping quality below 30.
-minQ 20: Discard bases with quality scores below 20.
-skipTriallelic 1: Skip triallelic sites.
-nThreads 16: Use 16 CPU threads for faster computation.
-minInd 112: Require at least 112 individuals to have data at a site.(more like max missing in vcftools, 112 out of 118 in our dataset means we only allow 5% missingness data)
-bam [bam_list.txt]: List of BAM files used as input.
-remove_bads 1: -baq 1 computes base alignment quality as explained here (BAQ) used to rule out false SNPs close to INDELS.
-only_proper_pairs 1: 
-C 50 reduces the effect of reads with excessive mismatches
-out angsd_gl: Prefix for output files.

Step 2: Linkage Disequilibrium Pruning with ngsLD

 Load necessary modules
module purge
module load angsd/intel/0.933
module load gsl/intel/2.6

# Set working directory
WORK_DIR="/scratch/work/winchell/Lanternfly/WGS/ANGSD"
OUTPUT_DIR="${WORK_DIR}/ngsLD"
#mkdir -p $OUTPUT_DIR

# Define input files
GENO_FILE="${WORK_DIR}/angsd_minInd112.beagle.gz"
MAFS_FILE="${WORK_DIR}/angsd_minInd112.mafs.gz"
POS_FILE="${WORK_DIR}/angsd_minInd112.pos"
N_IND=118  # Number of individuals

# Step 1.1: Count the number of sites
echo "Counting the number of sites in MAF file..."
N_SITES=$(zcat $MAFS_FILE | tail -n +2 | wc -l)
echo "Number of sites: $N_SITES"

# Step 1.2: Generate POS_FILE
echo "Generating position file..."
zcat $MAFS_FILE | tail -n +2 | cut -f 1,2 > $POS_FILE
echo "Position file generated: $POS_FILE"

# Step 2: Run ngsLD within Singularity
echo "Running ngsLD..."
/scratch/work/public/singularity/run-ngs-tools-1.8.5.bash bash -c "
/home/fm2371/bin/ngsLD \
  --geno $GENO_FILE \
  --probs \
  --n_ind $N_IND \
  --n_sites $N_SITES \
  --pos $POS_FILE \
  --min_maf 0.05 \
  --max_kb_dist 10 \
  --n_threads 16 \
  --out ${OUTPUT_DIR}/LD_output_10kb.txt
"

echo "ngsLD analysis completed successfully."

--geno FILE: input file with genotypes, genotype likelihoods or genotype posterior probabilities.
--probs: is the input genotype probabilities (likelihoods or posteriors)?
--log_scale: is the input in log-scale?
--n_ind INT: sample size (number of individuals).
--n_sites INT: total number of sites.
--pos(H) FILE: input file with site coordinates (one per line), where the 1st column stands for the chromosome/contig and the 2nd for the position (bp); remaining columns will be ignored but included in output; --posH assumes there is a header.
--max_kb_dist DOUBLE: maximum distance between SNPs (in Kb) to calculate LD.

