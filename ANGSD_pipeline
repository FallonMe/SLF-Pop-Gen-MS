# List all heterozygosity txt files
file_list <- list.files(input_dir, pattern = "_heterozygosity\\.txt$", full.names = TRUE)

# Initialize a data frame to store the results
results <- data.frame(SampleID = character(), Heterozygosity = numeric(), stringsAsFactors = FALSE)

# Iterate through each file and extract heterozygosity
for (file in file_list) {
  # Extract the sample ID from the file name
  sample_id <- gsub("_est\\.ml_heterozygosity\\.txt$", "", basename(file))
  
  # Read the heterozygosity value
  heterozygosity <- as.numeric(readLines(file, warn = FALSE))
  
  # Append to the results data frame
  results <- rbind(results, data.frame(SampleID = sample_id, Heterozygosity = heterozygosity))
}

# Save the results to a single output file
write.table(results, file = output_file, sep = "\t", row.names = FALSE, quote = FALSE)

# Print status
cat("Combined heterozygosity values saved to:", output_file, "\n")

